APP_NAME=INET
FRONTEND_PORT=8501
BACKEND_PORT=8000
# Message language for API clients and background jobs: en | ru (the web UI follows the browser).
INET_LANG=en

# --- LLM (optional) ---------------------------------------------------------
# Search and page reading work without an LLM. An LLM adds answers, deep
# research, self-repair and adapter generation. Easiest: run `inet setup`.
ENABLE_LLM=false
# openai | anthropic | google | groq | deepseek | ollama | openai_compatible
AI_PROVIDER=ollama
AI_MODEL=qwen3:8b
AI_TEMPERATURE=0
OLLAMA_BASE_URL=http://localhost:11434
# Any OpenAI-compatible endpoint (OpenRouter, LM Studio, vLLM, ProxyAPI, ...):
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=deepseek/deepseek-chat
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
# Per-request timeout, connect timeout and retries for LLM calls.
AI_TIMEOUT=180
AI_CONNECT_TIMEOUT=10
AI_MAX_RETRIES=4
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# --- Search and fetch ---------------------------------------------------------
# Optional self-hosted SearXNG (JSON output enabled). Without it INET uses
# DuckDuckGo, DDGS metasearch and Wikipedia, and can start SearXNG in Docker.
SEARXNG_URL=
# Order of engines tried by the DDGS metasearch provider.
DDGS_BACKEND=duckduckgo,brave,google,mojeek,yahoo
# Paid APIs are used only as a last fallback, within these monthly budgets.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_MONTHLY_LIMIT=100
FIRECRAWL_MONTHLY_LIMIT=100
# Browser-TLS HTTP (curl_cffi) and headless Chromium fallbacks.
ENABLE_CURL=true
ENABLE_BROWSER=true

# --- Automation and limits -------------------------------------------------------
ENABLE_AUTOMATION=true
MAINTENANCE_INTERVAL=3600
RUN_TIMEOUT=900
RECOVERY_WAIT_SECONDS=120
LLM_GENERATION_TIMEOUT=240
# Agent reasoning turns and technical tool executions are budgeted separately.
AGENT_MESSAGE_LIMIT=120
TOOL_CALL_LIMIT=480

# --- Sandbox (Docker; optional for local installs) ----------------------------------
MANAGED_SEARXNG_IMAGE=searxng/searxng:latest
SANDBOX_URL=http://127.0.0.1:8090
SANDBOX_TOKEN=replace-with-a-long-random-value
# Optional Fernet key for stored secrets. If empty, runtime/master.key is created.
INET_MASTER_KEY=

# --- CAPTCHA services (optional, paid) ------------------------------------------------
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=
CAPTCHA_MONTHLY_LIMIT=20

APP_NAME=INET
FRONTEND_PORT=8501
BACKEND_PORT=8000
# Search and fetch work without an LLM. Enable synthesis and diagnostics explicitly.
ENABLE_LLM=false
AI_PROVIDER=ollama
AI_MODEL=qwen3:8b
AI_TEMPERATURE=0
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=not-needed
# DSLab example:
# AI_PROVIDER=openai_compatible
# AI_MODEL=glm-5.2
# AI_BASE_URL=https://api.dslab.tech/v1
# AI_API_KEY=your-dslab-api-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# Optional search instance; enable JSON output in its settings.
SEARXNG_URL=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# Operator budgets, NOT promises about vendor free tiers.
TAVILY_MONTHLY_LIMIT=100
FIRECRAWL_MONTHLY_LIMIT=100
# Install requirements-browser.txt and Chromium before enabling these locally.
ENABLE_BROWSER=false
ENABLE_CURL=false
ENABLE_AUTOMATION=true
MAINTENANCE_INTERVAL=3600
RUN_TIMEOUT=900
RECOVERY_WAIT_SECONDS=120
LLM_GENERATION_TIMEOUT=240
# Managed tools are pulled by the sandbox service and pinned to the resolved digest.
MANAGED_SEARXNG_IMAGE=searxng/searxng:latest
SANDBOX_URL=http://127.0.0.1:8090
SANDBOX_TOKEN=replace-with-a-long-random-value
# Optional Fernet key for encryption. If empty, runtime/master.key is created.
INET_MASTER_KEY=
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=
CAPTCHA_MONTHLY_LIMIT=20
